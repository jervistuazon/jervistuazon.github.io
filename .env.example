# Copy this template to .env.r2.local and fill it in locally. Never commit keys.
# Use an R2 Object Read & Write token scoped to your media bucket.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY name the GitHub repository secrets.
# The local AWS CLI uploader expects AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
